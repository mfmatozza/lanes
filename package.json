{
  "name": "lanes",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "bench": "node scripts/bench-hook.ts",
    "package": "npm run build && cd packages/extension && vsce package --no-dependencies",
    "test": "node --test --test-concurrency=8 \"packages/*/test/**/*.test.ts\"",
    "server": "node packages/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.24.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfmatozza/lanes.git"
  },
  "homepage": "https://github.com/mfmatozza/lanes",
  "bugs": {
    "url": "https://github.com/mfmatozza/lanes/issues"
  }
}
